set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR arm)

set(TOOLCHAIN_PREFIX arm-none-eabi)

find_program(ARM_GCC
	NAMES ${TOOLCHAIN_PREFIX}-gcc
	REQUIRED)
find_program(ARM_GXX
	NAMES ${TOOLCHAIN_PREFIX}-g++
	REQUIRED)
find_program(ARM_AS
	NAMES ${TOOLCHAIN_PREFIX}-gcc
	REQUIRED)
find_program(ARM_AR
	NAMES ${TOOLCHAIN_PREFIX}-ar
	REQUIRED)
find_program(ARM_OBJCOPY
	NAMES ${TOOLCHAIN_PREFIX}-objcopy
	REQUIRED)
find_program(ARM_OBJDUMP
	NAMES ${TOOLCHAIN_PREFIX}-objdump
	REQUIRED)
find_program(ARM_SIZE
	NAMES ${TOOLCHAIN_PREFIX}-size
	REQUIRED)

set(CMAKE_C_COMPILER ${ARM_GCC})
set(CMAKE_CXX_COMPILER ${ARM_GXX})
set(CMAKE_ASM_COMPILER ${ARM_AS})
set(CMAKE_AR ${ARM_AR})
set(CMAKE_OBJCOPY ${ARM_OBJCOPY})
set(CMAKE_OBJDUMP ${ARM_OBJDUMP})
set(CMAKE_SIZE ${ARM_SIZE})

set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)

set(CMAKE_EXECUTABLE_SUFFIX ".elf")
